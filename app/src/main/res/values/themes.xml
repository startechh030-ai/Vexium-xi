<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main theme -->
    <style name="Theme.Obris" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!--
        Startup theme — uses SplashScreen API to OVERRIDE Android 12+ default.
        Shows pure black with NO icon. Instantly transitions to our custom splash.
    -->
    <style name="Theme.Obris.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF000000</item>
        <!-- Use a tiny transparent drawable instead of app icon -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Obris</item>
    </style>
</resources>
